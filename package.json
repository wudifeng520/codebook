{
  "name": "local-vault",
  "version": "2.0.1",
  "description": "完全离线的 Windows 本地加密密码本",
  "main": "src/main.js",
  "author": "Junfeng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "icon": "node tools/generate-icon.js",
    "dist": "npm run test && npm run icon && electron-builder --win nsis portable",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish.ps1"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.localvault.desktop",
    "productName": "本地密码本",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "本地密码本-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "本地密码本",
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "portable": {
      "artifactName": "本地密码本-便携版-${version}-${arch}.${ext}"
    }
  }
}
